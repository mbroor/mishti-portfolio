---
import '../styles/global.css';
const { title = 'Mishti Broor', description = 'Biomedical engineer working across bioelectronics, neural interfaces, wearable sensing, and human-subject research.' } = Astro.props;
const base = '/mishti-portfolio/';
const resumeUrl = 'https://drive.google.com/file/d/1G_Ssr0d5Gii7ro_BA77Bx_fRt_DBN7I6/view?usp=drivesdk';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b2823" />
    <title>{title}</title>
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href={base}>Mishti Broor</a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href={base}>Home</a>
          <a href={`${base}about`}>About</a>
          <a href={`${base}work`}>Work</a>
          <a href={`${base}writing`}>Writing</a>
          <a href={`${base}artwork`}>Artwork</a>
          <a class="nav-cta" href={resumeUrl} target="_blank" rel="noopener noreferrer">Résumé ↗</a>
        </nav>
        <details class="mobile-nav">
          <summary aria-label="Open navigation menu">Menu <span aria-hidden="true">☰</span></summary>
          <nav aria-label="Mobile navigation">
            <a href={base}>Home</a>
            <a href={`${base}about`}>About</a>
            <a href={`${base}work`}>Work</a>
            <a href={`${base}writing`}>Writing</a>
            <a href={`${base}artwork`}>Artwork</a>
            <a href={resumeUrl} target="_blank" rel="noopener noreferrer">Résumé ↗</a>
          </nav>
        </details>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="container footer-inner">
        <div>© {new Date().getFullYear()} Mishti Broor</div>
        <div class="footer-links">
          <a href="mailto:mishtibroor2028@u.northwestern.edu">Email</a>
          <a href="https://www.linkedin.com/in/mishti-broor" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href={`${base}artwork`}>Artwork</a>
          <a href={resumeUrl} target="_blank" rel="noopener noreferrer">Résumé</a>
        </div>
      </div>
    </footer>
  </body>
</html>
