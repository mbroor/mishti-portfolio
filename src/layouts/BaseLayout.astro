---
import '../styles/global.css';
const { title = 'Mishti Broor', description = 'Biomedical engineer working across bioelectronics, neural interfaces, wearable sensing, and human-subject research.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f4" />
    <title>{title}</title>
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href={base}>Mishti Broor</a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href={`${base}projects`}>Projects</a>
          <a href={`${base}research`}>Research</a>
          <a href={`${base}bioelectronics`}>Bioelectronics</a>
          <a href={`${base}writing`}>Writing</a>
          <a href={`${base}about`}>About</a>
          <a class="nav-cta" href={`${base}docs/mishti-broor-resume.pdf`} target="_blank">Résumé ↗</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="container footer-inner">
        <div>© {new Date().getFullYear()} Mishti Broor</div>
        <div class="footer-links">
          <a href="mailto:mishtibroor2028@u.northwestern.edu">Email</a>
          <a href="https://www.linkedin.com/in/mishti-broor" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href={`${base}docs/mishti-broor-resume.pdf`} target="_blank">Résumé</a>
        </div>
      </div>
    </footer>
  </body>
</html>
