---
import '../styles/global.css';
const { title = 'Mishti Broor', description = 'Biomedical engineer working across bioelectronics, neural interfaces, wearable sensing, and human-subject research.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f4" />
    <title>{title}</title>
  </head>
  <body>
    <header class="nav">
      <div class="container nav-inner">
        <a class="brand" href="/">Mishti Broor</a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="/projects">Projects</a>
          <a href="/research">Research</a>
          <a href="/bioelectronics">Bioelectronics</a>
          <a href="/writing">Writing</a>
          <a href="/about">About</a>
          <a class="nav-cta" href="/docs/mishti-broor-resume.pdf" target="_blank">Résumé ↗</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="container footer-inner">
        <div>© {new Date().getFullYear()} Mishti Broor</div>
        <div class="footer-links">
          <a href="mailto:mishtibroor2028@u.northwestern.edu">Email</a>
          <a href="https://www.linkedin.com/in/mishti-broor" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="/docs/mishti-broor-resume.pdf" target="_blank">Résumé</a>
        </div>
      </div>
    </footer>
  </body>
</html>
