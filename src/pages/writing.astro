const totalArticles = groups.reduce((count, group) => count + group.articles.length, 0);
---
<BaseLayout title="Writing — Mishti Broor" description="Mishti Broor's published technical writing about neural interfaces, wearable brain sensing, neuromodulation, bioelectronics, and medical devices.">
  <section class="page-hero">
    <div class="container">
      <div class="eyebrow">Technical writing · Neurotechnology</div>
      <h1>Understanding emerging neurotechnology by writing about it.</h1>
      <p>Deep dives into the engineering behind brain–computer interfaces, wearable biosensors, neuromodulation, and translational medical devices. Browse {totalArticles} verified articles from my <a href="https://www.mishtibroor.com/technical-blogs" target="_blank" rel="noopener noreferrer"><strong>Google Sites writing archive ↗</strong></a>.</p>
    </div>
  </section>
  {groups.map((group) => (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2>{group.name}</h2>
          <p>{group.description}</p>
        </div>
        <div class="list">
          {group.articles.map((article) => (
            <a class="list-row" href={article.url} target="_blank" rel="noopener noreferrer" aria-label={`Read article ${article.number}: ${article.title}`}>
              <div class="date">Article {String(article.number).padStart(2, '0')}</div>
              <div><h3>{article.title}</h3></div>
              <div>Read ↗</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}
  <section class="section">
    <div class="container">
      <div class="card span-12">
        <div class="eyebrow">External publication</div>
        <h3>Writing at Neurofounders</h3>
        <p>I also contribute reporting and explainers on neurotechnology, wearable health, and emerging neural interfaces. See my published work through my author profile.</p>
        <div class="hero-actions">
          <a class="button primary" href="https://www.neurofounders.co/author/mishti-broor" target="_blank" rel="noopener noreferrer">Read my Neurofounders articles ↗</a>
          <a class="button" href="https://www.mishtibroor.com/technical-blogs" target="_blank" rel="noopener noreferrer">Original Google Sites archive ↗</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
