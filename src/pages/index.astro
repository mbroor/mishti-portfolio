---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = '/mishti-portfolio/';
const img = 'https://raw.githubusercontent.com/mbroor/mishti-portfolio/main/public/images/';
---
<BaseLayout title="Mishti Broor — Bioelectronics & Neural Sensing">
  <section class="hero">
    <div class="container">
      <div class="eyebrow">Bioelectronics · Neural Interfaces · Wearable Sensing</div>
      <h1>Building better interfaces to biological signals.</h1>
      <p class="lead">I’m a Biomedical Engineering M.S. student at Northwestern University working across EEG hardware, wearable sensing, human-subject research, and biosignal analysis — with a growing focus on bioelectronics and neural interfaces.</p>
      <div class="hero-actions">
        <a class="button primary" href={`${base}projects`}>View projects →</a>
        <a class="button" href={`${base}docs/mishti-broor-resume.pdf`} target="_blank">Résumé ↗</a>
        <a class="button" href="https://www.linkedin.com/in/mishti-broor" target="_blank" rel="noreferrer">LinkedIn ↗</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Selected work</h2>
        <p>Engineering projects that connect sensing hardware, experimental validation, and real-world human use.</p>
      </div>
      <div class="grid">
        <a class="card feature-card image-card span-7" href={`${base}projects/inclusive-eeg-electrodes`}>
          <div>
            <div class="eyebrow">Featured · EEG hardware</div>
            <h3>Inclusive EEG electrode hardware</h3>
            <p>Engineered and validated novel EEG electrode attachments for unbraided and cornrowed hair, from CAD and resin 3D printing through a 30-participant study.</p>
            <div class="meta"><span class="tag">CAD</span><span class="tag">3D printing</span><span class="tag">EEG</span><span class="tag">Human studies</span><span class="tag">Signal quality</span></div>
          </div>
          <img src={`${img}eeg-poster-solo.jpeg`} alt="Mishti Broor presenting her EEG electrode research poster" />
        </a>

        <a class="card feature-card image-card span-5" href={`${base}projects/spinal-cord-model`}>
          <div>
            <div class="eyebrow">Medical device design</div>
            <h3>High-fidelity spinal cord model</h3>
            <p>Designed an anatomically detailed in-vitro model of the spinal subarachnoid space for cerebrospinal-fluid flow studies.</p>
            <div class="meta"><span class="tag">Fusion 360</span><span class="tag">MSLA printing</span><span class="tag">Silicone</span><span class="tag">1st place BME</span></div>
          </div>
          <img src={`${img}spinal-cord-expo.jpeg`} alt="Mishti Broor presenting the spinal cord model at the UIC Engineering Expo" />
        </a>

        <a class="card span-4" href={`${base}research`}><h3>Clinical EEG research</h3><p>M.S. thesis work at Northwestern focused on clinical electrophysiology and quantitative EEG.</p><span class="arrow">↗</span></a>
        <a class="card span-4" href={`${base}bioelectronics`}><h3>Bioelectronics direction</h3><p>Electrodes, analog front ends, wearable sensing, embedded systems, and neural interfaces.</p><span class="arrow">↗</span></a>
        <a class="card span-4" href={`${base}writing`}><h3>Technical writing</h3><p>Analysis of emerging neurotechnology, wearable biosensing, BCI products, and translational devices.</p><span class="arrow">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section"><div class="container statement"><p>I’m especially interested in the engineering challenge of taking biological signals that are measurable in controlled laboratories and designing <span>hardware that can acquire them reliably in the real world.</span></p></div></section>

  <section class="section">
    <div class="container">
      <div class="section-header"><h2>Currently building toward</h2><p>The technical areas I’m intentionally developing during graduate school.</p></div>
      <div class="grid">
        <div class="card span-6"><div class="eyebrow">01</div><h3>Bioelectronics</h3><p>Electrodes, low-noise biosignal acquisition, analog front ends, wearable sensing, and device integration.</p></div>
        <div class="card span-6"><div class="eyebrow">02</div><h3>Clinical EEG</h3><p>Neural dynamics, electrophysiological biomarkers, and quantitative analysis of clinical recordings.</p></div>
        <div class="card span-6"><div class="eyebrow">03</div><h3>Signal processing</h3><p>Filtering, spectral analysis, EEG decoding, reproducible pipelines, and multimodal biosignal analysis.</p></div>
        <div class="card span-6"><div class="eyebrow">04</div><h3>Translation</h3><p>How sensing technologies move from engineering prototypes and human studies into usable medical and consumer devices.</p></div>
      </div>
    </div>
  </section>
</BaseLayout>
