---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = '/mishti-portfolio/';
const img = 'https://raw.githubusercontent.com/mbroor/mishti-portfolio/main/public/images/';
---
<BaseLayout title="Mishti Broor — Bioelectronics & Neural Sensing">
  <section class="hero">
    <div class="container">
      <div class="eyebrow">Biomedical Engineering · Northwestern University</div>
      <h1>Hi, I'm Mishti. <em>I like making things work.</em></h1>
      <p class="lead">I'm a biomedical engineering master's student at Northwestern. My work has taken me from CAD and 3D-printed EEG electrode attachments to human-subject studies and signal analysis. I'm now working on wearable clinical EEG hardware.</p>
      <div class="hero-actions">
        <a class="button primary" href={`${base}projects`}>View projects →</a>
        <a class="button" href="https://doi.org/10.64898/2026.10.01.755885" target="_blank" rel="noreferrer">EEG preprint ↗</a>
        <a class="button" href="https://drive.google.com/file/d/1G_Ssr0d5Gii7ro_BA77Bx_fRt_DBN7I6/view?usp=drivesdk" target="_blank">Résumé ↗</a>
        <a class="button" href="https://www.linkedin.com/in/mishti-broor" target="_blank" rel="noreferrer">LinkedIn ↗</a>
      </div>
    </div>
  </section>

  <section class="focus-intro" id="selected-work">
    <div class="container focus-intro-row">
      <div><div class="eyebrow">01 / Selected work</div><h2>Some things I've made.</h2></div>
      <p>Scroll to explore two projects that took me from CAD models to physical prototypes and testing.</p>
    </div>
  </section>

  <section class="focus-stories" aria-label="Selected engineering projects">
    <div class="focus-stage" data-focus-stage>
      <a class="focus-story" href="/mishti-portfolio/projects/inclusive-eeg-electrodes">
        <div class="focus-details">
          <span class="eyebrow">01 / EEG hardware · UIC</span>
          <h3>Designing for better scalp contact.</h3>
          <p>Developing EEG electrode attachments for textured hair meant working through CAD, fabrication, and the practical challenges of testing on people.</p>
          <div class="focus-cta"><span>CAD · 3D printing · EEG</span><strong>Explore project ↗</strong></div>
        </div>
        <div class="focus-photo">
          <img src="/mishti-portfolio/images/eeg-poster-solo.jpeg" alt="Mishti presenting her EEG electrode attachment research" loading="lazy" />
          <span>EEG electrode research / UIC</span>
        </div>
      </a>
    </div>
    <div class="focus-stage" data-focus-stage>
      <a class="focus-story" href="/mishti-portfolio/projects/spinal-cord-model">
        <div class="focus-details">
          <span class="eyebrow">02 / Medical device design · UIC</span>
          <h3>Making anatomy tangible.</h3>
          <p>An in-vitro model of the spinal subarachnoid space, developed using CAD and fabrication methods for cerebrospinal-fluid flow studies.</p>
          <div class="focus-cta"><span>Fusion 360 · MSLA · silicone</span><strong>Explore project ↗</strong></div>
        </div>
        <div class="focus-photo">
          <img src="/mishti-portfolio/images/spinal-cord-expo.jpeg" alt="Mishti at the UIC Engineering Expo with the spinal cord model" loading="lazy" />
          <span>Spinal cord model / Engineering Expo</span>
        </div>
      </a>
    </div>
    <p class="focus-end-note">There’s usually more to a project than the final prototype.</p>
  </section>

  <section class="section"><div class="container statement"><p>I’m especially interested in the engineering challenge of taking biological signals that are measurable in controlled laboratories and designing <span>hardware that can acquire them reliably in the real world.</span></p></div></section>

  <section class="section">
    <div class="container">
      <div class="section-header"><h2>Currently building toward</h2><p>The technical areas I’m intentionally developing during graduate school.</p></div>
      <div class="grid">
        <div class="card span-6"><div class="eyebrow">01</div><h3>Bioelectronics</h3><p>Electrodes, low-noise biosignal acquisition, analog front ends, wearable sensing, and device integration.</p></div>
        <div class="card span-6"><div class="eyebrow">02</div><h3>Clinical EEG</h3><p>Neural dynamics, electrophysiological biomarkers, and quantitative analysis of clinical recordings.</p></div>
        <div class="card span-6"><div class="eyebrow">03</div><h3>Signal processing</h3><p>Filtering, spectral analysis, EEG decoding, reproducible pipelines, and multimodal biosignal analysis.</p></div>
        <div class="card span-6"><div class="eyebrow">04</div><h3>Translation</h3><p>How sensing technologies move from engineering prototypes and human studies into usable medical and consumer devices.</p></div>
      </div>
    </div>
  </section>
</BaseLayout>


<script>
  const stages = [...document.querySelectorAll('[data-focus-stage]')];
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let framePending = false;

  function updateFocus() {
    framePending = false;
    if (prefersReducedMotion.matches) return;
    const viewportHeight = window.innerHeight;
    for (const stage of stages) {
      const rect = stage.getBoundingClientRect();
      const entering = viewportHeight * 0.87;
      const focused = viewportHeight * 0.20;
      const amount = Math.max(0, Math.min(1, (entering - rect.top) / (entering - focused)));
      stage.querySelector('.focus-story').style.setProperty('--focus', amount.toFixed(3));
    }
  }
  function scheduleFocus() {
    if (!framePending) {
      framePending = true;
      requestAnimationFrame(updateFocus);
    }
  }
  function handleMotionSetting() {
    document.body.classList.toggle('focus-motion', !prefersReducedMotion.matches);
    if (!prefersReducedMotion.matches) scheduleFocus();
  }
  handleMotionSetting();
  window.addEventListener('scroll', scheduleFocus, { passive: true });
  window.addEventListener('resize', scheduleFocus);
  prefersReducedMotion.addEventListener('change', handleMotionSetting);
</script>
