---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = '/mishti-portfolio/';
const img = 'https://raw.githubusercontent.com/mbroor/mishti-portfolio/main/public/images/';
---
<BaseLayout title="Mishti Broor — Bioelectronics & Neural Sensing">
  <section class="hero">
    <div class="container">
      <div class="eyebrow">Biomedical Engineering · Northwestern University</div>
      <h1>Hi, I'm Mishti. <em>I like making things work.</em></h1>
      <p class="lead">I'm a biomedical engineering master's student at Northwestern. My work has taken me from CAD and 3D-printed EEG electrode attachments to human-subject studies and signal analysis. I'm now working on wearable clinical EEG hardware.</p>
      <div class="hero-actions">
        <a class="button primary" href={`${base}projects`}>View projects →</a>
        <a class="button" href="https://doi.org/10.64898/2026.10.01.755885" target="_blank" rel="noreferrer">EEG preprint ↗</a>
        <a class="button" href="https://drive.google.com/file/d/1G_Ssr0d5Gii7ro_BA77Bx_fRt_DBN7I6/view?usp=drivesdk" target="_blank">Résumé ↗</a>
        <a class="button" href="https://www.linkedin.com/in/mishti-broor" target="_blank" rel="noreferrer">LinkedIn ↗</a>
      </div>
    </div>
  </section>

  <section class="focus-intro" id="selected-work">
    <div class="container focus-intro-row">
      <div><div class="eyebrow">01 / Selected work</div><h2>Some things I've made.</h2></div>
      <p>Scroll to explore two projects that took me from CAD models to physical prototypes and testing.</p>
    </div>
  </section>


  <section class="precision-chapter" aria-label="Selected projects, focusing and receding with scrolling">
    <div class="precision-track" data-precision-track>
      <div class="precision-viewport" data-precision-viewport>
        <p class="precision-hint">SELECTED WORK / SCROLL TO FOCUS</p>
        <a class="focus-story precision-card" data-precision-card data-project="0" href="/mishti-portfolio/projects/inclusive-eeg-electrodes">
          <div class="focus-details">
            <span class="eyebrow">01 / EEG hardware · UIC</span>
            <h3>Designing for better scalp contact.</h3>
            <p>I designed and 3D-printed EEG electrode attachments for textured hair, then helped evaluate them in a 30-participant study.</p>
            <div class="focus-cta"><span>CAD · 3D printing · EEG</span><strong>Explore project ↗</strong></div>
          </div>
          <div class="focus-photo">
            <img src="/mishti-portfolio/images/eeg-poster-solo.jpeg" alt="Mishti presenting her EEG electrode research" loading="lazy" />
            <span>EEG electrode research / UIC</span>
          </div>
        </a>
        <a class="focus-story precision-card" data-precision-card data-project="1" href="/mishti-portfolio/projects/spinal-cord-model">
          <div class="focus-details">
            <span class="eyebrow">02 / Medical device design · UIC</span>
            <h3>Making anatomy tangible.</h3>
            <p>I worked on an in-vitro spinal cord model for cerebrospinal-fluid flow studies, using CAD and fabrication techniques.</p>
            <div class="focus-cta"><span>Fusion 360 · MSLA · silicone</span><strong>Explore project ↗</strong></div>
          </div>
          <div class="focus-photo">
            <img src="/mishti-portfolio/images/spinal-cord-expo.jpeg" alt="Mishti showing her spinal cord model at the UIC Engineering Expo" loading="lazy" />
            <span>Spinal cord model / Engineering Expo</span>
          </div>
        </a>
        <div class="precision-progress" aria-hidden="true"><span data-precision-bar></span></div>
        <div class="precision-counter" data-precision-counter>01 / 02</div>
      </div>
    </div>
    <div class="container precision-outro"><p>There’s usually more to a project than the final prototype.</p></div>
  </section>

  <section class="section"><div class="container statement"><p>I’m especially interested in the engineering challenge of taking biological signals that are measurable in controlled laboratories and designing <span>hardware that can acquire them reliably in the real world.</span></p></div></section>

  <section class="section">
    <div class="container">
      <div class="section-header"><h2>What I’m learning about</h2><p>These are interests I’m exploring, not a list of projects I’ve completed.</p></div>
      <div class="grid">
        <div class="card span-6"><div class="eyebrow">01</div><h3>Bioelectronics</h3><p>I’m learning more about biosignal acquisition electronics and how sensors become usable wearable devices.</p></div>
        <div class="card span-6"><div class="eyebrow">02</div><h3>Clinical EEG</h3><p>I’m working on wearable clinical EEG hardware and learning how device choices affect reliable recordings.</p></div>
        <div class="card span-6"><div class="eyebrow">03</div><h3>Signal processing</h3><p>Filtering, spectral analysis, and MATLAB-based analysis from my EEG work.</p></div>
        <div class="card span-6"><div class="eyebrow">04</div><h3>Device design</h3><p>I’m interested in what it takes to turn a working prototype into something useful outside the lab.</p></div>
      </div>
    </div>
  </section>
</BaseLayout>


<script>
  const track = document.querySelector('[data-precision-track]');
  const viewport = document.querySelector('[data-precision-viewport]');
  const cards = [...document.querySelectorAll('[data-precision-card]')];
  const bar = document.querySelector('[data-precision-bar]');
  const counter = document.querySelector('[data-precision-counter]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const clamp = (x, low, high) => Math.min(high, Math.max(low, x));
  let queued = false;

  function updateScrollFocus() {
    queued = false;
    if (reduced.matches || !track || !viewport) return;
    const top = parseFloat(getComputedStyle(viewport).top) || 0;
    const total = Math.max(1, track.offsetHeight - viewport.offsetHeight);
    const progress = clamp((top - track.getBoundingClientRect().top) / total, 0, 1);
    // Centers at 1/3 and 2/3 of the scroll track.
    // Each card scales IN and then scales OUT in both directions.
    const phase = progress * 3 - 1;
    cards.forEach((card, i) => {
      const offset = phase - i;
      const distance = clamp(Math.abs(offset), 0, 1);
      const presence = i === 0
        ? clamp((.90 - phase) / .30, 0, 1)
        : clamp((phase - .10) / .30, 0, 1);
      const scale = 1 - .34 * distance;
      const opacity = (1 - .64 * distance) * presence;
      card.style.setProperty('--scale', scale.toFixed(4));
      card.style.setProperty('--offset', (-offset * Math.min(245, innerHeight * .27)).toFixed(1) + 'px');
      card.style.setProperty('--opacity', opacity.toFixed(4));
      card.style.setProperty('--blur', (1.6 * distance).toFixed(2) + 'px');
      card.style.zIndex = String(Math.round((1.5 - distance) * 10));
      card.style.pointerEvents = distance < .45 && presence > .8 ? 'auto' : 'none';
    });
    bar.style.width = (progress * 100).toFixed(2) + '%';
    counter.textContent = phase > .5 ? '02 / 02' : '01 / 02';
  }
  function requestScrollFocus() {
    if (!queued) {
      queued = true;
      requestAnimationFrame(updateScrollFocus);
    }
  }
  function motionChange() {
    if (!reduced.matches) requestScrollFocus();
    else cards.forEach(card => {
      card.style.removeProperty('--scale');
      card.style.removeProperty('--offset');
      card.style.removeProperty('--opacity');
      card.style.removeProperty('--blur');
      card.style.pointerEvents = 'auto';
    });
  }
  window.addEventListener('scroll', requestScrollFocus, {passive:true});
  window.addEventListener('resize', requestScrollFocus);
  reduced.addEventListener('change', motionChange);
  motionChange();
</script>
