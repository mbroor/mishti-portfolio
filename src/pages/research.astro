---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = '/mishti-portfolio/';
---
<BaseLayout title="Research — Mishti Broor">
  <section class="page-hero"><div class="container"><div class="eyebrow">Research</div><h1>Neural signals, human studies, and translation.</h1><p>Research experience spanning EEG hardware, multimodal experiments, clinical electrophysiology, signal processing, and device-focused validation.</p></div></section>
  <section class="section"><div class="container">
    <div class="list">
      <div class="list-row"><div class="date">2026 — Present</div><div><h3>Clinical EEG research · Northwestern University</h3><p>M.S. thesis research in the Kimchi Lab, building toward clinical EEG and quantitative electrophysiology.</p></div><div>Northwestern</div></div>
      <div class="list-row"><div class="date">Nov 16, 2026</div><div><h3>Society for Neuroscience Annual Meeting · Poster</h3><p>Poster presentation: “Design and Test Novel EEG Electrodes for Afro-Textured Hair.”</p></div><div>Washington, DC</div></div>
      <div class="list-row"><div class="date">Mar 2025 — Present</div><div><h3>Research / Scientific Aide · Liu-CoMotion Lab</h3><p>EEG electrode hardware, 30-subject multimodal human study, synchronized BrainVision EEG/IMU/insole acquisition, and reproducible signal-analysis pipelines.</p></div><div>UIC</div></div>
      <div class="list-row"><div class="date">Jun — Aug 2025</div><div><h3>NIH-funded Clinical Immersion</h3><p>Ophthalmology immersion focused on workflow observation, unmet clinical needs, patient-device interaction, and translation opportunities.</p></div><div>UIC</div></div>
    </div>
  </div></section>
  <section class="section project-media"><div class="container"><img class="hero-image" src={`${base}images/eeg-poster-team.jpeg`} alt="Mishti Broor presenting EEG research with a collaborator" /></div></section>
</BaseLayout>
