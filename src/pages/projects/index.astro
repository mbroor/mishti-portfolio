---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Projects — Mishti Broor">
  <section class="page-hero"><div class="container"><div class="eyebrow">Projects</div><h1>Build. Test. Learn.</h1><p>Selected engineering work across neural sensing, medical-device prototyping, human-subject research, and biosignal analysis.</p></div></section>
  <section class="section"><div class="container"><div class="grid">
    <a class="card feature-card image-card span-7" href={`${base}projects/inclusive-eeg-electrodes`}><div><div class="eyebrow">EEG hardware</div><h3>Inclusive EEG electrode hardware</h3><p>Novel electrode attachments for unbraided and cornrowed hair, developed from CAD through human validation.</p><div class="meta"><span class="tag">CAD</span><span class="tag">Resin 3D printing</span><span class="tag">EEG</span><span class="tag">30 participants</span></div></div><img src={`${base}images/eeg-poster-discussion.jpeg`} alt="Mishti explaining her EEG electrode research at a poster presentation" /></a>
    <a class="card feature-card image-card span-5" href={`${base}projects/spinal-cord-model`}><div><div class="eyebrow">Medical device design</div><h3>High-fidelity in-vitro spinal cord model</h3><p>An anatomically detailed spinal subarachnoid-space model built for cerebrospinal-fluid flow experiments.</p><div class="meta"><span class="tag">Fusion 360</span><span class="tag">MSLA</span><span class="tag">Silicone</span><span class="tag">Expo award</span></div></div><img src={`${base}images/spinal-cord-expo.jpeg`} alt="Mishti presenting the spinal cord model at UIC Engineering Expo" /></a>
    <div class="card span-6"><div class="eyebrow">EEG decoding</div><h3>Motor imagery BCI classifier</h3><p>Built a 30-subject EEG motor-imagery pipeline using MNE-Python, CSP spatial filtering, and scikit-learn, with per-subject statistical validation.</p></div>
    <div class="card span-6"><div class="eyebrow">In progress</div><h3>Wearable bioelectronics notebook</h3><p>A living collection of small builds and experiments in electrodes, analog electronics, sensors, and embedded systems as I expand deeper into bioelectronics.</p></div>
  </div></div></section>
</BaseLayout>
